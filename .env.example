# ========================================
# BINANCE API CREDENTIALS
# ========================================
# Get these from: https://www.binance.com/en/account/api-management
# IMPORTANT: Never commit your real keys to git!
# Copy this file to .env and fill in your actual credentials

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ========================================
# TRADING CONFIGURATION
# ========================================
# Single pair trading (e.g., BTC/USDT, ETH/USDT)
TRADING_PAIR=BTCUSDT

# Amount in USDT to trade per position
POSITION_SIZE=100

# Enable/disable live trading (set to false for paper trading)
LIVE_TRADING=false

# ========================================
# ML MODEL CONFIGURATION
# ========================================
# Lookback period for technical indicators (in candles)
LOOKBACK_PERIOD=100

# Minimum confidence score for ML predictions (0-1)
ML_CONFIDENCE_THRESHOLD=0.65

# Model checkpoint path
MODEL_CHECKPOINT_PATH=./models/trading_model.h5

# ========================================
# NEWS SENTIMENT CONFIGURATION
# ========================================
# API key for news source (NewsAPI, etc.)
NEWS_API_KEY=your_news_api_key_here

# Update news sentiment every N minutes
NEWS_UPDATE_INTERVAL=30

# ========================================
# RISK MANAGEMENT
# ========================================
# Stop loss percentage (e.g., 0.05 = 5%)
STOP_LOSS_PERCENT=0.05

# Take profit percentage
TAKE_PROFIT_PERCENT=0.10

# Maximum positions to hold simultaneously
MAX_POSITIONS=1

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=info
LOG_FILE=./logs/trading.log

# ========================================
# BACKTESTING
# ========================================
# Days of historical data to use for backtesting
BACKTEST_DAYS=60

# Starting capital for backtest simulation
BACKTEST_INITIAL_CAPITAL=10000
